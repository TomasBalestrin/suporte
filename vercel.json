{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "devCommand": "npm run dev",
  "crons": [
    {
      "path": "/api/cron/sla",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/automations",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/follow-up",
      "schedule": "0 * * * *"
    }
  ]
}
