# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# OpenAI — so embeddings da base de conhecimento (chat completions migrou pra DeepInfra)
OPENAI_API_KEY=sk-...

# DeepInfra — chat completions (Sofia), endpoint OpenAI-compatible, mesmo modelo do Fluxon
DEEPINFRA_API_KEY=di-...

# Resend
RESEND_API_KEY=re_...
EMAIL_FROM=suporte@bethelsystems.com.br

# Telegram (opcional — encaminha conteúdo do suporte pro chat privado do dono)
# Sem BOT_TOKEN+CHAT_ID, o notifyTelegram é no-op (feature de notificação desligada).
# BOT_TOKEN: criar bot no @BotFather. CHAT_ID: pegar no @userinfobot.
TELEGRAM_BOT_TOKEN=123456:ABC-...
TELEGRAM_CHAT_ID=123456789
# WEBHOOK_SECRET: liga a MÃO DUPLA (responder ticket pelo Telegram). Segredo registrado no
# setWebhook; o Telegram o envia no header X-Telegram-Bot-Api-Secret-Token a cada POST.
# Sem ele, /api/telegram/webhook responde 200 mudo (mão dupla desligada). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=

# App
NEXT_PUBLIC_APP_URL=https://suporte.bethelsystems.com.br
NEXT_PUBLIC_APP_NAME=Bethel Suporte

# Cron Secret
CRON_SECRET=xxx

# Sentry (optional — error monitoring)
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_AUTH_TOKEN=sntrys_...
