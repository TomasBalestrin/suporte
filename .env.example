# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# OpenAI
OPENAI_API_KEY=sk-...

# Resend
RESEND_API_KEY=re_...
EMAIL_FROM=suporte@bethelsystems.com.br

# Telegram (opcional — encaminha conteúdo do suporte pro chat privado do dono)
# Sem estas duas, o notifyTelegram é no-op (feature desligada).
# BOT_TOKEN: criar bot no @BotFather. CHAT_ID: pegar no @userinfobot.
TELEGRAM_BOT_TOKEN=123456:ABC-...
TELEGRAM_CHAT_ID=123456789

# App
NEXT_PUBLIC_APP_URL=https://suporte.bethelsystems.com.br
NEXT_PUBLIC_APP_NAME=Bethel Suporte

# Cron Secret
CRON_SECRET=xxx

# Sentry (optional — error monitoring)
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_AUTH_TOKEN=sntrys_...
